# Copy this file to .env and fill it in. Never commit .env.

PORT=3000

# Recommended. When set, scouting, removing teams and writing game plans need this password.
# Viewing reports never does. Leave empty to let anyone with the link do everything.
ADMIN_PASSWORD=

# --- Game plans (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Storage ---
# Folder for the SQLite database. On a host, point this at a persistent disk/volume (Railway: /data).
DATA_DIR=./data

# --- TennisRecord politeness (defaults are fine) ---
SCOUT_CONCURRENCY=2
REQUEST_GAP_MS=1000
REQUEST_TIMEOUT_MS=90000
SECTION=So California
